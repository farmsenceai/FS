# Server
PORT=5003
NODE_ENV=development
# Set this to the public origin of this server. Change it when moving hosts.
APP_URL=http://localhost:5003
# Optional override only when the frontend uses a different origin.
FRONTEND_URL=
# Production only: optional comma-separated additional frontend origins.
CORS_ALLOWED_ORIGINS=

# Gates canonical organizations/farms/facilities/farm_assignments collections during the MongoDB architecture migration
ENABLE_CANONICAL_V2=false

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# Leave unset until a real production database exists. Then set its exact name to make all migrations refuse that database unconditionally.
PROTECTED_PRODUCTION_DB_NAME=

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
TERMS_VERSION=1.0

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=example@example.com
MAIL_PASS=replace-with-mail-app-password

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Optional; defaults to APP_URL + /api/auth/google/callback.
GOOGLE_CALLBACK_URL=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-client-secret
# Optional; defaults to APP_URL + /api/auth/microsoft/callback.
MICROSOFT_CALLBACK_URL=
MICROSOFT_TENANT_ID=common

# Free recorded demo footage (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=
